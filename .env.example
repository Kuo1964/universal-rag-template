# 目前啟用的產品設定檔名稱（對應 profiles/<ACTIVE_PROFILE>.yaml）
ACTIVE_PROFILE=default

# 向量嵌入提供者：預設 fastembed（免安裝 Ollama 即可離線產生 768 維向量），可改為 ollama
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=llama3.2-vision

# 向量資料庫與集合名稱（留空則使用專案目錄下的 ./vector_db 與依 Profile 自動命名）
VECTOR_DB_PATH=
CHROMA_COLLECTION_NAME=

# 選配：僅在呼叫 ask_expert MCP 工具或啟動獨立 Web Portal (web_app.py) 時需要
# 若僅透過 IBM Bob / Claude 等智能體調用 search_kb 與 audit_grounding，無需填寫以下 API 金鑰
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Web Portal 伺服器設定（選配）
PORTAL_PORT=8888
SERVER_HOST=0.0.0.0
